<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Salary Slip - <%= employee?.first_name %> <%= employee?.last_name %></title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      @page {
        size: A4;
        margin: 0;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #1f2937;
        line-height: 1.4;
        background-color: #ffffff;
        font-size: 11px;
        padding: 0;
        margin: 0;
        -webkit-print-color-adjust: exact;
      }

      .page {
        width: 210mm;
        min-height: 297mm;
        padding: 15mm;
        margin: 0 auto;
        background: white;
        display: flex;
        flex-direction: column;
      }

      /* Utility */
      .uppercase { text-transform: uppercase; }
      .tracking-wider { letter-spacing: 0.05em; }
      .font-semibold { font-weight: 600; }

      /* Header */
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f3f4f6;
      }

      .logo {
        height: 60px;
        width: auto;
      }

      .net-pay-highlight {
        background: #ecfdf5;
        border: 1px solid #d1fae5;
        border-radius: 8px;
        padding: 16px 20px;
        text-align: center;
        width: 50%;
      }

      .net-pay-label {
        font-size: 14px;
        font-weight: 600;
        color: #065f46;
        margin-bottom: 4px;
      }

      .net-pay-amount {
        font-size: 28px;
        font-weight: 700;
        color: #047857;
        margin-bottom: 5px;
      }

      .breakdown {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 34px;
      }

      .breakdown-item {
        display: flex;
        flex-direction: column;
      }

      .breakdown-label {
        font-size: 12px;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .breakdown-amount {
        font-size: 18px;
        font-weight: 600;
      }

      .deductions-color {
        color: tomato;
      }

      /* Document Title */
      .document-title {
        margin-bottom: 30px;
      }

      .document-title h2 {
        font-size: 14px;
        text-align: center;
        padding: 6px;
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        color: #374151;
      }

      /* Employee Info Section */
      .info-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
      }

      .info-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
      }

      .info-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #f3f4f6;
        padding: 4px 6px;
        margin: 4px 0;
      }

      .info-item:last-child {
        border-bottom: none;
      }

      .info-label {
        font-size: 14px;
        color: #6b7280;
        font-weight: 500;
      }

      .info-value {
        font-size: 14px;
        font-weight: 600;
        color: #111827;
      }

      /* Attendance Summary */
      .attendance-summary {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        font-size: 10px;
        color: #6b7280;
      }

      .attendance-item {
        background: #f9fafb;
        padding: 4px 10px;
        border-radius: 4px;
        border: 1px solid #e5e7eb;
      }

      /* Salary Breakdown Table */
      .salary-table-container {
        display: flex;
        gap: 20px;
        /* border: 1px solid #e5e7eb; */
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 20px;
      }

      .salary-column {
        flex: 1;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
      }

      /* .salary-column:last-child {
        border-right: none;
      } */

      .table-header {
        background-color: #f9fafb;
        padding: 8px 12px;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 0.05em;
        color: #374151;
      }

      .table-header.deductions-header {
        background-color: #feebeb;
      }

      .deductions-column {
        background-color: #feebeb;
      }

      .deductions-column .table-row {
        border-bottom-color: #feebeb;
      }

      .deductions-column .total-row {
        background-color: #feebeb;
        /* color: #b91c1c; */
      }

      .table-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px;
        border-bottom: 1px solid #f3f4f6;
      }

      .table-row:last-child {
        border-bottom: none;
      }

      .total-row {
        background-color: #f9fafb;
        font-weight: 700;
        border-top: 1px solid #e5e7eb;
      }

      /* Net Pay Summary Box */
      .net-pay-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #111827;
        color: #ffffff;
        padding: 15px 20px;
        border-radius: 6px;
        margin-bottom: 8px;
      }

      .amount-in-words {
        font-size: 11px;
        color: #4b5563;
        font-style: italic;
        text-align: right;
        padding-right: 5px;
      }

      /* Footer */
      .footer {
        margin-top: auto;
        padding-top: 20px;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        font-size: 9px;
        color: #9ca3af;
        letter-spacing: 0.1em;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <!-- header -->
      <div class="header">
        <!-- Company Info -->
        <% if (logo) { %>
           <img src="data:image/png;base64,<%= logo %>" alt="Logo" class="logo" />
        <% } %>
        <div class="net-pay-highlight">
            <div class="net-pay-label">Employee Net Pay</div>
            <div class="net-pay-amount" id="net-pay-amount">
              <%= salary.net_salary %>
            </div>
            <div class="breakdown">
              <div class="breakdown-item">
                <div class="breakdown-label deductions deductions-color">Deductions</div>
                <div class="breakdown-amount deductions deductions-color" id="deductions-amount">
                  <%= salary?.deduction %>
                </div>
              </div>
              <div class="breakdown-item">
                <div class="breakdown-label gross-pay">Gross Pay</div>
                <div class="breakdown-amount gross-pay" id="gross-pay-amount">
                  <%= salary?.salary %>
                </div>
              </div>
            </div>
        </div>
      </div>
      <!-- Document Title -->
      <div class="document-title">
          <h2 class="uppercase tracking-wider">Payslip for the month of <%= pay_period %></h2>
      </div>

      <!-- Employee Info Section -->
        <div class="info-section">
            <div class="info-group">
                <div class="info-item">
                    <span class="info-label">Employee Name</span>
                    <span class="info-value"><%= employee?.first_name %> <%= employee?.last_name %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Designation</span>
                    <span class="info-value"><%= employee?.designation?.title %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Employee ID</span>
                    <span class="info-value"><%= employee?.employee_id || 'N/A' %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Date of Joining</span>
                    <span class="info-value"><%= new Date(employee?.date_of_joining).toLocaleDateString() %></span>
                </div>
            </div>
            <div class="info-group">
                <div class="info-item">
                    <span class="info-label">PF A/C Number</span>
                    <span class="info-value"><%= employee?.EmployeePersonalInformation?.epf_no || 'N/A' %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">ESI Number</span>
                    <span class="info-value"><%= employee?.EmployeePersonalInformation?.esic_no || 'N/A' %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Pay Date</span>
                    <span class="info-value"><%= pay_date %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Payment Mode</span>
                    <span class="info-value">Bank Transfer</span>
                </div>
            </div>
        </div>

        <!-- Attendance Summary -->
        <div class="attendance-summary">
            <div class="attendance-item">
                <span class="font-semibold">Paid Days:</span> <%= month_days %>
            </div>
            <div class="attendance-item">
                <span class="font-semibold">LOP Days:</span> <%= total_leave %>
            </div>
        </div>
        <div style="height: 20px;"></div>

        <!-- Salary Breakdown Table -->
        <div class="salary-table-container">
            <!-- Earnings -->
            <div class="salary-column">
                <div class="table-header">Earnings</div>
                <div class="table-row">
                    <span>Basic Salary</span>
                    <span class="font-semibold"><%= salary?.base_salary %></span>
                </div>
                <div class="table-row">
                    <span>HRA</span>
                    <span class="font-semibold"><%= employee?.employee_salary?.hra || '0.00' %></span>
                </div>
                <!-- Fill empty rows to align with deductions if needed -->
                <div class="table-row total-row">
                    <span>Gross Earnings</span>
                    <span><%= salary?.salary %></span>
                </div>
            </div>

            <!-- Deductions -->
            <div class="salary-column deductions-column">
                <div class="table-header deductions-header">Deductions</div>
                <div class="table-row">
                    <span>EPF Contribution</span>
                    <span class="font-semibold"><%= total_epf %></span>
                </div>
                <% if (salary?.deduction && parseFloat(salary.deduction) > parseFloat(total_epf)) { %>
                <div class="table-row">
                    <span>Other Deductions</span>
                    <span class="font-semibold"><%= (parseFloat(salary.deduction) - parseFloat(total_epf)).toFixed(2) %></span>
                </div>
                <% } else { %>
                <div class="table-row" style="color: transparent;">
                    <span>-</span>
                    <span>-</span>
                </div>
                <% } %>
                <div class="table-row total-row">
                    <span>Total Deductions</span>
                    <span><%= salary?.deduction || total_epf %></span>
                </div>
            </div>
        </div>

        <!-- Net Pay Summary -->
        <div class="net-pay-box">
            <span class="net-pay-label uppercase">Net Payable</span>
            <span class="net-pay-amount"><%= salary?.net_salary %></span>
        </div>
        <div class="amount-in-words">
          Amount in words: <span class="font-semibold"><%= amount_in_inr %></span>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>********** THIS IS A COMPUTER GENERATED PAYSLIP, NO SIGNATURE REQUIRED **********</p>
        </div>
    </div>
  </body>
</html>